          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="step4" value="5. Generated JS bindings lower the result&lt;br&gt;js-guest-bindgen · allocates and writes canonical result data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0c2;strokeColor=#96700c;fontColor=#243746;fontSize=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="65" y="526" width="970" height="79" />
