        </mxCell>
        <mxCell id="step1" value="2. Generated native core wrapper receives the call&lt;br&gt;wit_export_i · Rust on Boa / C on Porffor · boxes raw core arguments" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d7efdf;strokeColor=#387b53;fontColor=#243746;fontSize=16;" vertex="1" parent="1">
