          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="step6" value="7. Host lifts the result and invokes canonical post-return&lt;br&gt;Wasmtime owns this phase; the native A wrapper frees its tracked result allocations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dceafb;strokeColor=#4776aa;fontColor=#243746;fontSize=16;" vertex="1" parent="1">
