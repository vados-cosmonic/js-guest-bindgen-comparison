        </mxCell>
        <mxCell id="step2" value="3. Generic native push_* callbacks create engine values&lt;br&gt;native/common/runtime_c.c · roots values on a call stack; composites use WIT metadata" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d7efdf;strokeColor=#387b53;fontColor=#243746;fontSize=16;" vertex="1" parent="1">
