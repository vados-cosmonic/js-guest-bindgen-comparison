          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="step4" value="5. Generic native pop_* callbacks extract the result&lt;br&gt;Native engine adapter converts JS values using the uniform wit-dylib contract" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d7efdf;strokeColor=#387b53;fontColor=#243746;fontSize=16;" vertex="1" parent="1">
