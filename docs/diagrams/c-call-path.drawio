          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="step5" value="6. wit-dylib world.so lowers the result&lt;br&gt;Generated Wasm owns canonical memory layout, flat values and return areas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eadffa;strokeColor=#8253a7;fontColor=#243746;fontSize=16;" vertex="1" parent="1">
