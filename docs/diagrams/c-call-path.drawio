        </mxCell>
        <mxCell id="step1" value="2. wit-dylib world.so receives the core call&lt;br&gt;Calls export_start for a context, then lifts canonical arguments through native Wasm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eadffa;strokeColor=#8253a7;fontColor=#243746;fontSize=16;" vertex="1" parent="1">
