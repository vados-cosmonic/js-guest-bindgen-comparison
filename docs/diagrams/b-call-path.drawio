        </mxCell>
        <mxCell id="step0" value="1. Host calls a component export&lt;br&gt;Wasmtime lowers host values to the guest Canonical ABI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dceafb;strokeColor=#4776aa;fontColor=#243746;fontSize=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="65" y="90" width="970" height="79" />
        </mxCell>
        <mxCell id="step1" value="2. Generated native ABI runtime receives the core call&lt;br&gt;wit-bindgen-c output · lifts canonical memory / flat values into typed C values" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eadffa;strokeColor=#8253a7;fontColor=#243746;fontSize=16;" vertex="1" parent="1">
