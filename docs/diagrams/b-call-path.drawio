          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="step5" value="6. Generated native ABI runtime lowers the result&lt;br&gt;wit-bindgen-c output · writes canonical offsets, flat values and return areas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eadffa;strokeColor=#8253a7;fontColor=#243746;fontSize=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="65" y="635" width="970" height="79" />
