          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="step4" value="5. Native engine shim unboxes the application result&lt;br&gt;Extracts typed native values through engine APIs · releases temporary JS roots" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d7efdf;strokeColor=#387b53;fontColor=#243746;fontSize=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="65" y="526" width="970" height="79" />
