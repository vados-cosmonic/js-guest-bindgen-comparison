          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="step3" value="4. Application JavaScript runs&lt;br&gt;Boa interprets JS bytecode · Porffor executes AOT-compiled Wasm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde1d7;strokeColor=#aa6243;fontColor=#243746;fontSize=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="65" y="417" width="970" height="79" />
