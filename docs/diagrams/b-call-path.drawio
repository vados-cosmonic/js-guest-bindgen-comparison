          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="step2" value="3. Interface-specific native engine shim boxes arguments&lt;br&gt;native/common/shims_b.c · uses Boa / Porffor APIs; no canonical memory layout work" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d7efdf;strokeColor=#387b53;fontColor=#243746;fontSize=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="65" y="308" width="970" height="79" />
